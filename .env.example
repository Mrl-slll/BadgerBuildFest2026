# AI Provider: 'databricks' (live or mock fallback), 'databricks-mock' (explicit mock), or 'development' (default mock)
AI_PROVIDER=databricks

# Databricks Workspace Configuration (Server-side only; NEVER prefix with NEXT_PUBLIC_)
DATABRICKS_HOST=https://<your-databricks-workspace-instance>.cloud.databricks.com
DATABRICKS_TOKEN=dapi...

# Mosaic AI Model Serving Endpoint Name (e.g. Foundation Model API or Custom Serving Endpoint)
DATABRICKS_SERVING_ENDPOINT=databricks-meta-llama-3-3-70b-instruct

# Mosaic AI Vector Search Index (Unity Catalog full path: catalog.schema.index)
DATABRICKS_VECTOR_INDEX=pcos.vector_search.disease_symptoms_v2_vs_index

# Databricks SQL Warehouse ID (For Delta Lake storage & clinician expert reviews)
DATABRICKS_SQL_WAREHOUSE_ID=

# Set to true to force realistic mock evaluation even if credentials are present
DATABRICKS_MOCK=false

# Clerk Authentication
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
